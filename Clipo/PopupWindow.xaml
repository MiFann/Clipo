<Window x:Class="Clipo.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="400" Height="500"
        KeyDown="Window_KeyDown">

    <Border Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1"
            CornerRadius="10" Padding="12,8,12,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Drag Handle -->
            <Border Grid.Row="0" Height="20" Background="Transparent"
                    MouseLeftButtonDown="DragBar_MouseLeftButtonDown"
                    Cursor="Hand" Margin="0,0,0,4">
                <Grid>
                    <TextBlock Text="Clipo" Foreground="#555" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text="&#x2715;" Foreground="#666" FontSize="14"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Cursor="Hand" Margin="0,0,4,0"
                               MouseLeftButtonDown="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Search Bar -->
            <Border Grid.Row="1" Background="#2D2D2D" CornerRadius="6"
                    BorderBrush="#3A3A3A" BorderThickness="1" Margin="0,0,0,8" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F50D;" Foreground="#888" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#E0E0E0" CaretBrush="#E0E0E0"
                             FontSize="14" VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    <TextBlock Grid.Column="2" Text="&#x2715;" Foreground="#666" FontSize="14"
                               VerticalAlignment="Center" Cursor="Hand" Margin="4,0,0,0"
                               MouseLeftButtonDown="ClearSearch_Click"/>
                </Grid>
            </Border>

            <!-- List -->
            <ListBox x:Name="HistoryList" Grid.Row="2"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#E0E0E0" FontSize="13"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="HistoryList_PreviewMouseLeftButtonDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border" Background="Transparent"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Pin indicator -->
                                            <TextBlock x:Name="PinIcon" Grid.Row="0" Grid.RowSpan="2"
                                                       Grid.Column="0" Text="&#x1F4CC;"
                                                       FontSize="10" Foreground="#0078D4"
                                                       Visibility="Collapsed"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>

                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding DisplayText}"
                                                       Foreground="#E0E0E0" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="40" TextWrapping="NoWrap"/>

                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding TimeAgo}"
                                                       Foreground="#666" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#0078D4"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#333"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Border" Property="Background" Value="#0078D4"/>
                                        </MultiTrigger>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter TargetName="PinIcon" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                    <ContextMenu Background="#2D2D2D" Foreground="#E0E0E0" BorderBrush="#3A3A3A">
                        <MenuItem Header="粘贴" Click="MenuPaste_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x1F4CB;" FontSize="12"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="复制到剪贴板" Click="MenuCopy_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x1F4C4;" FontSize="12"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="MenuPin" Header="置顶" Click="MenuPin_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x1F4CC;" FontSize="12"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="删除" Click="MenuDelete_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#x1F5D1;" FontSize="12"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="清空全部" Click="MenuClearAll_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- Footer -->
            <Border Grid.Row="3" Margin="0,8,0,0" Padding="0,4,0,0">
                <Grid>
                    <TextBlock Text="{Binding ElementName=HistoryList, Path=Items.Count, StringFormat='{}共 {0} 条记录'}"
                               Foreground="#555" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="← 点击粘贴" Foreground="#555" FontSize="11" Margin="0,0,8,0"/>
                        <TextBlock Text="↑↓键选择" Foreground="#555" FontSize="11" Margin="0,0,8,0"/>
                        <TextBlock Text="Esc关闭" Foreground="#555" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
